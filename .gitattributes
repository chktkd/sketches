# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.bash text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Scripts
*.fish text eol=lf
*.zsh text eol=lf

# Serialization
*.json text
*.toml text
*.xml text
*.yaml text
*.yml text

# Documentation
*.md text
*.txt text
AUTHORS text
CHANGELOG text
CHANGES text
CONTRIBUTING text
COPYING text
copyright text
*COPYRIGHT* text
INSTALL text
license text
LICENSE text
NEWS text
readme text
*README* text
TODO text

# Configuration
*.cnf text
*.conf text
*.config text
.editorconfig text
.env text
.gitattributes text export-ignore
.gitconfig text
.gitignore text export-ignore
.htaccess text
*.lock text -diff
*.npmignore text
*.ini text

