# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Python files
[*.py]
indent_size = 4
max_line_length = 120

# Go files
[*.go]
indent_style = tab
indent_size = 4

# Makefile
[Makefile]
indent_style = tab

# Shell scripts
[*.{sh,bash,zsh}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# JavaScript/TypeScript
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# CSS/SCSS/LESS
[*.{css,scss,sass,less}]
indent_size = 2

# HTML
[*.{html,htm}]
indent_size = 2

# XML
[*.xml]
indent_size = 2

# Java
[*.java]
indent_size = 4

# C/C++
[*.{c,cc,cpp,cxx,h,hpp,hxx}]
indent_size = 4

# Rust
[*.rs]
indent_size = 4
max_line_length = 100

# Ruby
[*.rb]
indent_size = 2

# PHP
[*.php]
indent_size = 4

# SQL
[*.sql]
indent_size = 2

# Package files
[{package.json,package-lock.json,*.lock}]
indent_size = 2

# Configuration files
[*.{toml,ini,conf,config}]
indent_size = 2

# Batch files (Windows)
[*.{bat,cmd}]
end_of_line = crlf
