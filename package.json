{
  "name": "sketches",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Web expression sketches, published with GitHub Pages",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "new": "node scripts/new-sketch.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
